# Variables de entorno de AutoNota (SDD, Parte 0, sección 0.6). Sin valores reales.
# Copiar a apps/api/.env para la API y a apps/web/.env para la SPA.

# --- API ---
# development, test o production
NODE_ENV=development
# Puerto en el que escucha la API
PORT=3000
# Conexión a PostgreSQL (Docker en local, Neon en producción)
DATABASE_URL=postgresql://autonota:autonota@localhost:5432/autonota
# Clave para firmar los access tokens de 15 minutos (ADR-006). Mínimo 32 caracteres.
JWT_ACCESS_SECRET=
# Duración del refresh token, en días
REFRESH_TOKEN_DIAS=30
# URL pública de la SPA, para el link de recuperación de contraseña
APP_URL=http://localhost:5173
# Credenciales OAuth de Gmail (ADR-011). Obligatorias en producción.
# En desarrollo, si faltan, el mail de recuperación se escribe en el log de la API.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Remitente de los mails
MAIL_FROM=AutoNota <cuenta@gmail.com>
# Envío de errores a Sentry (ADR-013). Opcional.
SENTRY_DSN=

# --- SPA ---
# Envío de errores del navegador a Sentry. Opcional.
VITE_SENTRY_DSN=
